# ── Required ───────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional overrides ─────────────────────────
# LLM model (default: claude-sonnet-4-6)
# LLM_MODEL=claude-sonnet-4-6

# Local embedding model (default: all-MiniLM-L6-v2)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector store directory (default: ./chroma_db)
# CHROMA_PERSIST_DIR=./chroma_db

# ChromaDB collection name (default: rag_documents)
# COLLECTION_NAME=rag_documents

# Document chunking
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# Top-K retrieval results
# TOP_K=4

# Max query-rewrite retries before giving up
# MAX_RETRIES=2
